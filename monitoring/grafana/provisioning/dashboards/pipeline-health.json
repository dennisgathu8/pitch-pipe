{
  "title": "pitch-pipe: Pipeline Health",
  "uid": "pitchpipe-pipeline-health",
  "editable": true,
  "schemaVersion": 39,
  "tags": ["pitch-pipe"],
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Replay Active",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "STOPPED", "color": "red" }, "1": { "text": "RUNNING", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        { "datasource": "Prometheus", "expr": "pitch_pipe_replay_active", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Throughput (events/sec)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 }, "overrides": [] },
      "targets": [
        { "datasource": "Prometheus", "expr": "sum(rate(pitch_pipe_events_processed_total[1m]))", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Spec Validation Failure Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "green" }, { "value": 0.01, "color": "red" }] }
        },
        "overrides": []
      },
      "targets": [
        { "datasource": "Prometheus", "expr": "sum(rate(pitch_pipe_spec_validation_failures_total[5m]))", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "p95 Ingestion Lag",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "green" }, { "value": 0.5, "color": "yellow" }, { "value": 2, "color": "red" }] }
        },
        "overrides": []
      },
      "targets": [
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.95, sum(rate(pitch_pipe_ingestion_lag_seconds_bucket[5m])) by (le))", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "Throughput Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (mode) (rate(pitch_pipe_events_processed_total[1m]))",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Ingestion Lag (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(pitch_pipe_ingestion_lag_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(pitch_pipe_ingestion_lag_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(pitch_pipe_ingestion_lag_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 7,
      "title": "Spec Validation Failures (cumulative)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 15 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "pitch_pipe_spec_validation_failures_total",
          "legendFormat": "failures",
          "refId": "A"
        }
      ]
    }
  ]
}
