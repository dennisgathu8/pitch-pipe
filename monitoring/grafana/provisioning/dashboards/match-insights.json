{
  "title": "pitch-pipe: Match Insights",
  "uid": "pitchpipe-match-insights",
  "editable": true,
  "schemaVersion": 39,
  "tags": ["pitch-pipe"],
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Cumulative xG",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 2, "custom": { "drawStyle": "line", "fillOpacity": 15 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "pitch_pipe_shot_xg_sum",
          "legendFormat": "Total xG",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Shots by Zone",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "none" },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (zone) (pitch_pipe_shots_total)",
          "legendFormat": "{{zone}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 3,
      "title": "Event Volume (events/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 15 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (mode) (rate(pitch_pipe_events_processed_total[1m]) * 60)",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Events by Type",
      "type": "bargauge",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "none" },
        "overrides": []
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient" },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (event_type) (pitch_pipe_events_by_type_total)",
          "legendFormat": "{{event_type}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    }
  ]
}
